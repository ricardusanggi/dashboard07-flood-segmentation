# backend/.env.example
# Copy to .env and fill in your own values.

# =====================================================
# APPLICATION
# =====================================================
ALLOWED_ORIGINS=http://localhost:3007,http://127.0.0.1:3007
DATABASE_URL=sqlite:///storage/databases/localcaviar_segment.db
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# =====================================================
# STORAGE PATHS
# =====================================================
TRAIN_DATASET_DIR=./storage/datasets_train
PENDING_DATASET_DIR=./storage/datasets_pending
REJECT_DATASET_DIR=./storage/datasets_reject
TEST_DATASET_DIR=./storage/datasets_test
TEST_TRUE_DIR=./storage/datasets_test_true

TRAIN_MODEL_DIR=./storage/models_train
UPLOAD_MODEL_DIR=./storage/models_upload
PREDICT_MODEL_DIR=./storage/models_predict
REJECT_MODEL_DIR=./storage/models_reject

LOG_DIR=./storage/logs

# =====================================================
# ML TASK
# =====================================================
CASE_DATASET=segmentation_dataset
ML_TASK=segmentation

# Metode segmentasi: otsu | adaptive | watershed | kmeans | unet | deeplab
SEGMENTATION_METHOD=model

# =====================================================
# PARAMETER SEGMENTASI (METODE KLASIK)
# =====================================================

# Threshold biner hasil segmentasi (0.0 - 1.0)
SEGMENT_THRESHOLD=0.5

# K-Means: jumlah cluster
SEGMENT_KMEANS_K=3

# Adaptive Threshold: ukuran blok (harus ganjil >= 3) dan konstanta C
SEGMENT_ADAPTIVE_BLOCK=11
SEGMENT_ADAPTIVE_C=2

# Morfologi: ukuran kernel dan jumlah iterasi untuk post-processing
SEGMENT_MORPH_KERNEL=3
SEGMENT_MORPH_ITERATIONS=1

# Watershed: jumlah marker awal dan kompaktness
SEGMENT_WATERSHED_MARKERS=20
SEGMENT_WATERSHED_COMPACTNESS=0.001

# =====================================================
# DEFAULT ADMIN
# =====================================================
DEFAULT_ADMIN_USERNAME=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me
DEFAULT_ADMIN_FULLNAME=Admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_ROLE=admin
DEFAULT_ADMIN_IS_ACTIVE=true
DEFAULT_ADMIN_IS_SUPERUSER=true

# =====================================================
# TRAINING CONFIGURATION (UNTUK METODE unet DAN deeplab)
# =====================================================

# Arsitektur model: unet | deeplab
TRAIN_ARCHITECTURE=unet

# DeepLab: gunakan pretrained backbone ImageNet saat training baru
DEEPLAB_PRETRAINED_BACKBONE=true

TRAIN_EPOCHS=50
TRAIN_BATCH_SIZE=4
TRAIN_LEARNING_RATE=0.0001
TRAIN_OPTIMIZER=adam

# Loss function: bce | dice | bce_dice | iou
TRAIN_LOSS_FUNCTION=bce_dice

TRAIN_AUGMENTATION=true
TRAIN_VAL_SPLIT=0.2
TRAIN_IMG_SIZE=256

# ---- PSO (OPSIONAL, hanya berlaku untuk unet) ----
USE_PSO=false
PSO_POPULATION=5
PSO_ITERS=10
PSO_EPOCHS=2

PSO_LR_MIN=0.00001
PSO_LR_MAX=0.001
PSO_DROPOUT_MIN=0.1
PSO_DROPOUT_MAX=0.5
PSO_HIDDEN_SIZES=128,256,512
PSO_BATCH_SIZES=2,4,8
PSO_AUGMENTATION=true

# =====================================================
# KONFIGURASI INFERENSI / PREDIKSI
# =====================================================
PREDICT_BATCH_SIZE=1
PREDICT_IMG_SIZE=256
PREDICT_THRESHOLD=0.5
PREDICT_AUGMENTATION=false
PREDICT_SLIDE_WINDOW_SIZE=256
PREDICT_SLIDE_WINDOW_STRIDE=128
